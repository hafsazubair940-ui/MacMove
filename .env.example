# Copy these into Vercel: Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (starts with sb_publishable_) or the legacy "anon" key. Safe for browsers.
SUPABASE_ANON_KEY=
# The secret key (starts with sb_secret_) or the legacy "service_role" key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys. SERVER ONLY.
ANTHROPIC_API_KEY=
